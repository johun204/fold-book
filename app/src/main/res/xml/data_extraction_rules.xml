<!-- 저장소 연결(공유폴더 계정 정보)은 백업·기기 이전에 넣지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="connections.json" />
        <exclude domain="file" path="connections.json.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="connections.json" />
        <exclude domain="file" path="connections.json.bak" />
    </device-transfer>
</data-extraction-rules>
