<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/pathText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:paddingBottom="8dp" />

    <ListView android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="8dp">

        <Button android:id="@+id/signInBtn"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/drive_sign_in" />

        <Button android:id="@+id/upBtn"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/drive_up" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <Button android:id="@+id/openHereBtn"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/drive_open_here" />
    </LinearLayout>
</LinearLayout>
